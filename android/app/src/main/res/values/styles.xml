<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动闪屏：AndroidX SplashScreen（12+ 原生 API，旧版本由兼容库
         回填）。品牌 M 徽标 + 背景色，等 Flutter 首帧画完再收（MainActivity
         的 keep-on-screen 条件由 Dart 侧 "ready" 解除）。 -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mint_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mint_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">280</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 闪屏收起后到 Flutter 首帧之间垫同色，避免白/黑闪一下。 -->
        <item name="android:windowBackground">@color/mint_splash_background</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="android:colorAccent">@color/mint_accent</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="AppAlertDialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/mint_accent</item>
    </style>

    <!-- 游戏宿主（:game）：全屏、无标题、纯黑。Compose 自己的主题在代码里，
         这里只保证窗口本身不再套 Holo 那套深灰控件。 -->
    <style name="GameTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/mint_accent</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
