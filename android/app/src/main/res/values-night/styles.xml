<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme 不在这里覆盖：values/styles.xml 的 SplashScreen 主题
         + 本目录的 mint_splash_background 颜色自动出深色版。 -->
    <style name="NormalTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mint_splash_background</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="android:colorAccent">@color/mint_accent</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="AppAlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/mint_accent</item>
    </style>
    <style name="GameTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/mint_accent</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
